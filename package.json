{
  "name": "koinonia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de gobernanza colectiva para el Instituto de Filosofía de la Universidad de Antioquia",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint . && prettier --check . && node scripts/check-domain-purity.mjs",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.0.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
