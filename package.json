{
  "name": "koinonia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de gobernanza colectiva para el Instituto de Filosofía de la Universidad de Antioquia",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc -p tsconfig.check.json && tsc --build packages/contracts services/api && tsc -p tests/e2e/tsconfig.json",
    "lint": "eslint . && prettier --check . && node scripts/check-domain-purity.mjs",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "build:web": "pnpm --filter @koinonia/web run build",
    "dev": "node scripts/dev.mjs",
    "e2e": "tsc --build packages/contracts services/api && playwright test",
    "e2e:matriz": "tsc --build packages/contracts services/api && KOINONIA_MATRIZ=completa playwright test",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@koinonia/api": "workspace:*",
    "@koinonia/contracts": "workspace:*",
    "@koinonia/crypto": "workspace:*",
    "@koinonia/domain": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.0.0",
    "fast-check": "^4.9.0",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "testcontainers": "^11.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
