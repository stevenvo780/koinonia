{
  "name": "@koinonia/verificar",
  "version": "0.1.0",
  "type": "module",
  "description": "Verificador independiente de Koinonía: comprueba un export sin hablar con el servidor que lo produjo",
  "license": "AGPL-3.0-or-later",
  "sideEffects": false,
  "bin": {
    "verificar": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --root ../.. packages/verifier-cli"
  },
  "dependencies": {
    "@koinonia/anchor": "workspace:*",
    "@koinonia/crypto": "workspace:*"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
