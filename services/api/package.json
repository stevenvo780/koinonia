{
  "name": "@koinonia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adaptadores de Koinonía: persistencia del ledger sobre PostgreSQL. Lo único que hace I/O",
  "license": "AGPL-3.0-or-later",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
