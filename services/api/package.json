{
  "name": "@koinonia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adaptadores de Koinonía: persistencia del ledger sobre PostgreSQL. Lo único que hace I/O",
  "license": "AGPL-3.0-or-later",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc --build",
    "start": "node ./dist/bin.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@koinonia/anchor": "workspace:*",
    "@koinonia/consensus": "workspace:*",
    "@koinonia/contracts": "workspace:*",
    "@koinonia/crypto": "workspace:*",
    "@koinonia/domain": "workspace:*",
    "@koinonia/verificar": "workspace:*",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "koinonia-api": "./dist/bin.js"
  }
}
