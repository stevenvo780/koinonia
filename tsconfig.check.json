{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@koinonia/crypto": ["./packages/crypto/src/index.ts"],
      "@koinonia/anchor": ["./packages/anchor/src/index.ts"],
      "@koinonia/verificar": ["./packages/verifier-cli/src/index.ts"],
      "@koinonia/domain": ["./packages/domain/src/index.ts"],
      "@koinonia/metrics": ["./packages/metrics/src/index.ts"],
      "@koinonia/contracts": ["./packages/contracts/src/index.ts"],
      "@koinonia/api": ["./services/api/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "services/*/src/**/*.ts",
    "services/*/test/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["tests/e2e/**"]
}
