# api.167.114.118.213.sslip.io — API de Koinonía. AÑADIDO 2026-08-23.
#
# Bloque nuevo al final del fichero. No se modificó ni una línea de los bloques
# anteriores; en particular NO se tocó ns512213.ip-167-114-118.net, cuyo
# certificado consumen demeter-cert-sync.timer y postfix-sync-cert.timer.
#
# Backend: contenedor `koinonia-api` (/opt/koinonia/docker-compose.yml), publicado
# SÓLO en 127.0.0.1:18090. PostgreSQL (`koinonia-postgres`) no publica ningún
# puerto: sólo lo alcanza la API por la red docker `koinonia_net`.
#
# Revertir TODO el fichero: cp de Caddyfile.bak-koinonia-registro-* (ver DESPLIEGUE.md §9.3) y
# `systemctl reload caddy`. Revertir SÓLO este bloque a como estaba antes de este cambio (sin log ni
# cabeceras nuevas): cp de Caddyfile.bak-koinonia-* (el backup del 2026-08-23, anterior a este
# cambio) y `systemctl reload caddy`.
#
# AÑADIDO 2026-08-24: registro de acceso a fichero (sin IP, sin Cookie, sin Authorization, sin
# Set-Cookie, sin cadena de consulta; la emisión de papeleta no genera línea) y tres cabeceras de
# seguridad estáticas. Ver el comentario de cabecera de este fichero para el porqué completo, y el
# aviso sobre THREAT_MODEL.md RA-8 antes de aplicar esto en producción.
# ═══════════════════════════════════════════════════════════════════════════════
api.167.114.118.213.sslip.io {
	# Nunca se registra que se emitió una papeleta, ni con qué código respondió (ver punto 1 arriba).
	@papeletas {
		method POST
		path /decisiones/*/papeletas
	}
	skip_log @papeletas

	log {
		output file /var/log/caddy/koinonia-api-acceso.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
				request>uri regexp "\?.*" ""
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
	}

	reverse_proxy 127.0.0.1:18090
}

# ═══════════════════════════════════════════════════════════════════════════════
# koinonia.167.114.118.213.sslip.io — INTERFAZ de Koinonía. AÑADIDO 2026-08-23.
#
# Bloque nuevo al final del fichero. No se modificó ni una línea de los bloques
# anteriores; en particular NO se tocó ns512213.ip-167-114-118.net, cuyo
# certificado consumen demeter-cert-sync.timer y postfix-sync-cert.timer, ni
# mail.stevenvallejo.com, que es el certificado del submission de Postfix.
#
# Backend: contenedor `koinonia-web` (Next.js, /opt/koinonia/docker-compose.yml),
# publicado SÓLO en 127.0.0.1:18091.
#
# Por qué existe este dominio y no basta con el de la API: el enlace de acceso que
# se manda por correo apunta a /entrar/confirmar?token=…, que es una PANTALLA de
# Next, no un endpoint. Servida desde el dominio de la API daba 404.
#
# El navegador NO habla con la API directamente: la interfaz expone /api/* y lo
# reenvía por la red docker `koinonia_net` a koinonia-api:3001. Así la cookie de
# sesión es de primera parte y no hace falta CORS con credenciales ni SameSite=None.
#
# Revertir TODO el fichero: cp de Caddyfile.bak-koinonia-registro-* (ver DESPLIEGUE.md §9.3) y
# `systemctl reload caddy`. Revertir SÓLO este bloque a como estaba antes de este cambio (sin log ni
# cabeceras nuevas): cp de Caddyfile.bak-koinonia-web-* (el backup del 2026-08-23, anterior a este
# cambio) y `systemctl reload caddy`.
#
# AÑADIDO 2026-08-24: mismo registro de acceso que el bloque de la API (misma exclusión de la
# papeleta, con el prefijo /api de este proxy), más HSTS/X-Frame-Options/COOP y una CSP en modo
# SÓLO INFORME (nunca bloquea) — ver el porqué en el comentario dentro de la cabecera de más abajo,
# y el aviso sobre THREAT_MODEL.md RA-8 en el comentario de cabecera de este fichero.
# ═══════════════════════════════════════════════════════════════════════════════
koinonia.167.114.118.213.sslip.io {
	# Misma ruta de emisión, vista desde el proxy de la interfaz: `/api/<resto>` reenvía a `<resto>`
	# en la API sin tocarlo (apps/web/app/api/[...ruta]/route.ts), así que aquí lleva el prefijo /api.
	@papeletas {
		method POST
		path /api/decisiones/*/papeletas
	}
	skip_log @papeletas

	log {
		output file /var/log/caddy/koinonia-web-acceso.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
				request>uri regexp "\?.*" ""
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		# SÓLO INFORME, a propósito — no se pudo verificar sin bloquear la aplicación.
		#
		# THREAT_MODEL.md §6 fija una CSP con nonce por respuesta («script-src 'self'
		# 'nonce-<por-respuesta>'») pero esta interfaz (apps/web) no genera ese nonce hoy: no hay
		# middleware.ts ni mecanismo de nonce en el código (comprobado el 2026-08-23; es de otro
		# workflow y no se puede tocar aquí para agregarlo). Un Caddy estático no puede inventar un
		# nonce distinto por respuesta y hacer que coincida con lo que Next.js escribe en el HTML —
		# necesita cooperación de la aplicación, que no existe todavía.
		#
		# Por eso esto va en `-Report-Only`: un navegador NUNCA bloquea nada por esta cabecera, sólo
		# reporta a la consola qué habría bloqueado. Es deliberadamente la política ESTRICTA de
		# THREAT_MODEL.md sin nonce y sin 'unsafe-inline' —no una versión ya relajada— precisamente
		# para que el informe diga la verdad completa: cada script o estilo en línea que Next.js meta
		# sin nonce va a aparecer ahí. No lleva `report-uri`: THREAT_MODEL.md pide que apunte a «un
		# endpoint local que no registre IP» y ese endpoint no existe todavía en services/api (no se
		# creó aquí: es una ruta pública nueva, decisión que le corresponde a quien pida esa pieza,
		# no un efecto secundario de este cambio) — sin `report-uri`, el navegador igual escribe cada
		# violación en su consola, así que sigue sirviendo para observar a mano.
		#
		# ANTES DE VOLVERLA OBLIGATORIA (quitar `-Report-Only`): abrir la interfaz varios días con
		# las herramientas de desarrollo abiertas (o mirar `chrome://net-export`), revisar qué
		# violaciones reporta, y decidir con quien mantenga apps/web si hace falta 'unsafe-inline',
		# un nonce real, o si ya no hace falta nada. Aplicarla en modo obligatorio sin haber mirado
		# los informes puede dejar la aplicación en blanco: Next.js normalmente sí usa script/estilo
		# en línea.
		Content-Security-Policy-Report-Only "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'"
	}

	reverse_proxy 127.0.0.1:18091
}
