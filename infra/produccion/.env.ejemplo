# Koinonía — producción. Plantilla de infra/produccion/.env.ejemplo.
#
# Este fichero es un CALCO de las variables reales de /opt/koinonia/.env en la VPS, con cada
# secreto sustituido por un marcador entre <ÁNGULOS>. Los comentarios sí son los reales: explican
# decisiones que costó descubrir (el dominio SMTP obligatorio, el porqué del anclaje apagado, la
# repetición de la contraseña de Postgres). Cuando cambie algo real ahí, actualizá esto también.
#
# NUNCA pongas aquí un valor real. Para generar los secretos reales en la VPS se usó `openssl`
# directamente (ver DESPLIEGUE.md → "Generar los secretos"); no existe un generador en el repo.
#
# El original en la VPS lleva permisos 600 y esta línea encima: «NUNCA imprimir este fichero en un
# log ni copiarlo al repositorio». Esa regla sigue aplicando al fichero REAL, no a esta plantilla.

DATABASE_URL=postgresql://postgres:<CONTRASEÑA_POSTGRES>@koinonia-postgres:5432/koinonia
PORT=3001
NODE_ENV=production

# AÑADIDA <fecha-de-aplicación> junto con el registro de acceso (ver infra/produccion/DESPLIEGUE.md
# §9 y services/api/src/http/app.ts). Por código el nivel es `warn` —sin rastro de peticiones—, a
# propósito, para que las pruebas y el desarrollo local queden silenciosos; esta línea es lo que
# enciende el registro en la VPS. Sin ella, la aplicación vuelve a no dejar rastro de quién pidió
# qué, exactamente el hueco que esta línea cierra.
KOINONIA_LOG=info

KOINONIA_RATE_PEPPER=<PIMIENTA_DE_CUPOS_ALEATORIA_HEX>
KOINONIA_VAULT_MASTER_KEY=<CLAVE_MAESTRA_DEL_BAUL_BASE64>
KOINONIA_WEB_URL=https://koinonia.167.114.118.213.sslip.io

# Encargos. Sin al menos uno no hay quien abra votaciones.
# El adaptador de identidad SÓLO admite correos @udea.edu.co (adapters.ts:527), así que un
# correo del operador en otro dominio quedaría escrito y jamás podría entrar.
KOINONIA_FACILITADORES=<correo-facilitador>@udea.edu.co
KOINONIA_GARANTIAS=<correo-garantias>@udea.edu.co

# ═══════════════════════════════════════════════════════════════════════════════════════════════
# Anclaje externo — hoy APAGADO explícitamente. Ver infra/produccion/ANCLAJE.md ANTES de tocar nada
# de este bloque: ahí está qué protege, qué se gana y qué NO se gana encendiendo sólo la primera
# clase, y el procedimiento paso a paso para encender y para apagar.
#
# OJO: su valor por defecto en producción es ENCENDIDO (configuracion.ts:409, `activo` sigue a
# NODE_ENV cuando la variable no está). Sin esta línea puesta en `false`, el servicio saldría a
# OpenTimestamps en cada ciclo. Se deja explícita para que quien lea el .env sepa el estado real sin
# tener que conocer ese valor por defecto.
#
# OBLIGATORIA para decidir el estado. El resto de este bloque son las variables que ya existen en el
# código (configuracionDeAnclajeDesdeEntorno, services/api/src/anchor/configuracion.ts) con su valor
# recomendado para ESTA máquina. Las de OpenTimestamps son las únicas listas para usarse hoy —ya se
# verificaron contra los 4 calendarios reales, ver ANCLAJE.md §5—; las de git y correo quedan
# documentadas pero comentadas: la infraestructura que necesitan (repositorio de anclaje firmado,
# testigos con SMTP/IMAP/DKIM propios) todavía no existe (ANCLAJE.md §7).
KOINONIA_ANCLAJE=false

# ─── Clase `blockchain` (OpenTimestamps) — OPCIONALES, los valores por defecto ya sirven ─────────
# Sin ninguna de las líneas de abajo, KOINONIA_ANCLAJE=true ya ancla contra los 4 calendarios
# públicos de producción (alice.btc, bob.btc, finney.eternitywall, btc.catallaxy — verificados el
# 2026-08-24 contra el cliente oficial `ots info`). Se listan por si hace falta ajustar el ritmo.

# KOINONIA_ANCLAJE_CALENDARIOS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org,https://finney.calendar.eternitywall.com,https://btc.calendar.catallaxy.com
# KOINONIA_ANCLAJE_CALENDARIOS_MINIMO=1
# KOINONIA_ANCLAJE_BLOQUES_URL=https://blockstream.info/api
# KOINONIA_ANCLAJE_CHECKPOINT_MINUTOS=60

# Cada cuántas HORAS se le pide firma a los testigos de correo. NO es el corte de checkpoint.
#
# El corte es horario; si los testigos entraran en cada corte, a cada persona le llegarían 24
# peticiones de firma al día —dos órdenes en consola y una respuesta, cada una—. Nadie sostiene eso,
# y era el verdadero motivo de que el padrón siguiera vacío. Espaciarlo no debilita la garantía: los
# checkpoints encadenan, así que quien firma el de hoy atestigua también lo anterior. Ver ANCLAJE.md
# §7.4. La maduración —recoger acuses— sigue corriendo en cada vuelta, no la toca este número.
# KOINONIA_ANCLAJE_CORREO_CADA_HORAS=24
# KOINONIA_ANCLAJE_POLL_MINUTOS=60
# KOINONIA_ANCLAJE_PENDIENTES=24

# ─── Clase `vcs` (commit firmado en dos forjas) — NO ENCENDER hasta que exista el repositorio ────
# Requiere, fuera de esta máquina: un repositorio de anclaje con CHECKPOINTS.txt en Codeberg Y en
# GitHub (dos forjas, nunca una sola), y una clave SSH de la veeduría que NUNCA toque este servidor.
# Detalle completo en ANCLAJE.md §7.1. OBLIGATORIAS las tres primeras para que esta clase cuente en
# absoluto; OBLIGATORIA la cuarta para que cuente PARA EL QUÓRUM (su defecto es `false`: sin
# declararla, el anclaje de git se arma igual pero no cuenta — ver configuracion.ts:365-375).

# KOINONIA_ANCLAJE_FIRMANTES=Veeduría 2026-2 — <nombre>|<clave-pública-ssh-en-base64>
# KOINONIA_ANCLAJE_CODEBERG_REPO=<propietario>/<repositorio-de-anclaje>
# KOINONIA_ANCLAJE_GITHUB_REPO=<propietario>/<repositorio-de-anclaje>
# KOINONIA_ANCLAJE_CLAVE_FUERA_DEL_SERVIDOR=si
# KOINONIA_ANCLAJE_FORJAS=codeberg,github
# KOINONIA_ANCLAJE_CODEBERG_RAMA=anclaje
# KOINONIA_ANCLAJE_GITHUB_RAMA=anclaje
# KOINONIA_ANCLAJE_CODEBERG_TOKEN=<token-opcional-solo-si-repo-privado-o-limite-de-tasa>
# KOINONIA_ANCLAJE_GITHUB_TOKEN=<token-opcional-solo-si-repo-privado-o-limite-de-tasa>

# ─── Clase `human-witness` (testigos por correo) — NO ENCENDER hasta tener testigos designados ───
# Requiere un padrón real de testigos (perfiles enfrentados, al menos uno externo al Instituto —
# THREAT_MODEL.md §8.4) y SMTP/IMAP/DKIM PROPIOS del anclaje, separados de KOINONIA_SMTP_* de más
# arriba: ese SMTP es para las sesiones de entrada, éste es para el registro externo. Detalle
# completo en ANCLAJE.md §7.2. OBLIGATORIAS las tres primeras para que esta clase exista; sin IMAP
# el correo sale pero nadie recoge los acuses y nunca pasa de «pendiente»; sin DKIM sale sin firmar.

# KOINONIA_ANCLAJE_TESTIGOS=representacion_estudiantil|<correo>|<clave-publica-opcional>;externa|<correo>|
# KOINONIA_ANCLAJE_SMTP_HOST=<host-smtp-del-anclaje>
# KOINONIA_ANCLAJE_CORREO_FROM=Anclaje Koinonía <anclaje@<dominio>>
# KOINONIA_ANCLAJE_SMTP_USUARIO=<usuario-smtp-del-anclaje>
# KOINONIA_ANCLAJE_SMTP_CLAVE=<CONTRASEÑA_SMTP_DEL_ANCLAJE>
# KOINONIA_ANCLAJE_SMTP_PUERTO=587
# KOINONIA_ANCLAJE_SMTP_TLS=si
# KOINONIA_ANCLAJE_DOMINIOS_MINIMOS=3
# KOINONIA_ANCLAJE_IMAP_HOST=<host-imap-del-anclaje>
# KOINONIA_ANCLAJE_IMAP_USUARIO=<usuario-imap-del-anclaje>
# KOINONIA_ANCLAJE_IMAP_CLAVE=<CONTRASEÑA_IMAP_DEL_ANCLAJE>
# KOINONIA_ANCLAJE_DKIM_DOMINIO=<dominio-que-firma>
# KOINONIA_ANCLAJE_DKIM_SELECTOR=<selector-dkim>
# KOINONIA_ANCLAJE_DKIM_CLAVE_FICHERO=/ruta/a/la/clave-privada-dkim.pem
# KOINONIA_ANCLAJE_DKIM_ALGORITMO=rsa-sha256
# ═══════════════════════════════════════════════════════════════════════════════════════════════

# Contraseña de PostgreSQL: la consume docker compose por interpolación para el contenedor
# koinonia-postgres, y va repetida dentro de DATABASE_URL. Si se cambia, hay que cambiar las dos.
POSTGRES_PASSWORD=<CONTRASEÑA_POSTGRES>

# Correo saliente. AÑADIDO 2026-08-23 con el despliegue de la interfaz.
# Credencial SASL PROPIA (koinonia@stevenvallejo.com) contra el Postfix de la máquina por el
# 587 con STARTTLS. Se eligió esta vía y NO ampliar mynetworks: mynetworks es 127.0.0.0/8 y
# ampliarlo a la subred de Docker convertiría el Postfix en relevo abierto para los 66
# contenedores ajenos. Con SASL, sólo entra quien tiene esta clave.
# El nombre mail.stevenvallejo.com es obligatorio: el certificado se emite para ese nombre y el
# cliente verifica el certificado (conectar por IP fallaría la verificación).
KOINONIA_SMTP_HOST=mail.stevenvallejo.com
KOINONIA_SMTP_PORT=587
KOINONIA_SMTP_TLS=si
KOINONIA_SMTP_USER=koinonia@stevenvallejo.com
KOINONIA_SMTP_PASS=<CONTRASEÑA_SASL_DEL_BUZON_KOINONIA>
KOINONIA_SMTP_FROM=koinonia@stevenvallejo.com

# Rol de aplicación (migración 0003): la API sirve las peticiones como koinonia_app, que
# sobre governance.event sólo tiene SELECT e INSERT. KOINONIA_DB_APP_PASSWORD fija esta misma
# contraseña en el rol durante el arranque, con la conexión de migración.
KOINONIA_DATABASE_URL_APP=postgresql://koinonia_app:<CONTRASEÑA_ROL_APP>@koinonia-postgres:5432/koinonia
KOINONIA_DB_APP_PASSWORD=<CONTRASEÑA_ROL_APP>
