# Koinonía — producción. Plantilla de infra/produccion/.env.ejemplo.
#
# Este fichero es un CALCO de las variables reales de /opt/koinonia/.env en la VPS, con cada
# secreto sustituido por un marcador entre <ÁNGULOS>. Los comentarios sí son los reales: explican
# decisiones que costó descubrir (el dominio SMTP obligatorio, el porqué del anclaje apagado, la
# repetición de la contraseña de Postgres). Cuando cambie algo real ahí, actualizá esto también.
#
# NUNCA pongas aquí un valor real. Para generar los secretos reales en la VPS se usó `openssl`
# directamente (ver DESPLIEGUE.md → "Generar los secretos"); no existe un generador en el repo.
#
# El original en la VPS lleva permisos 600 y esta línea encima: «NUNCA imprimir este fichero en un
# log ni copiarlo al repositorio». Esa regla sigue aplicando al fichero REAL, no a esta plantilla.

DATABASE_URL=postgresql://postgres:<CONTRASEÑA_POSTGRES>@koinonia-postgres:5432/koinonia
PORT=3001
NODE_ENV=production

# AÑADIDA <fecha-de-aplicación> junto con el registro de acceso (ver infra/produccion/DESPLIEGUE.md
# §9 y services/api/src/http/app.ts). Por código el nivel es `warn` —sin rastro de peticiones—, a
# propósito, para que las pruebas y el desarrollo local queden silenciosos; esta línea es lo que
# enciende el registro en la VPS. Sin ella, la aplicación vuelve a no dejar rastro de quién pidió
# qué, exactamente el hueco que esta línea cierra.
KOINONIA_LOG=info

KOINONIA_RATE_PEPPER=<PIMIENTA_DE_CUPOS_ALEATORIA_HEX>
KOINONIA_VAULT_MASTER_KEY=<CLAVE_MAESTRA_DEL_BAUL_BASE64>
KOINONIA_WEB_URL=https://koinonia.167.114.118.213.sslip.io

# Encargos. Sin al menos uno no hay quien abra votaciones.
# El adaptador de identidad SÓLO admite correos @udea.edu.co (adapters.ts:527), así que un
# correo del operador en otro dominio quedaría escrito y jamás podría entrar.
KOINONIA_FACILITADORES=<correo-facilitador>@udea.edu.co
KOINONIA_GARANTIAS=<correo-garantias>@udea.edu.co

# Anclaje externo APAGADO explícitamente.
# OJO: su valor por defecto en producción es ENCENDIDO (configuracion.ts:410). Sin esta línea el
# servicio saldría a OpenTimestamps, a las forjas y al SMTP en cada ciclo.
KOINONIA_ANCLAJE=false

# Contraseña de PostgreSQL: la consume docker compose por interpolación para el contenedor
# koinonia-postgres, y va repetida dentro de DATABASE_URL. Si se cambia, hay que cambiar las dos.
POSTGRES_PASSWORD=<CONTRASEÑA_POSTGRES>

# Correo saliente. AÑADIDO 2026-08-23 con el despliegue de la interfaz.
# Credencial SASL PROPIA (koinonia@stevenvallejo.com) contra el Postfix de la máquina por el
# 587 con STARTTLS. Se eligió esta vía y NO ampliar mynetworks: mynetworks es 127.0.0.0/8 y
# ampliarlo a la subred de Docker convertiría el Postfix en relevo abierto para los 66
# contenedores ajenos. Con SASL, sólo entra quien tiene esta clave.
# El nombre mail.stevenvallejo.com es obligatorio: el certificado se emite para ese nombre y el
# cliente verifica el certificado (conectar por IP fallaría la verificación).
KOINONIA_SMTP_HOST=mail.stevenvallejo.com
KOINONIA_SMTP_PORT=587
KOINONIA_SMTP_TLS=si
KOINONIA_SMTP_USER=koinonia@stevenvallejo.com
KOINONIA_SMTP_PASS=<CONTRASEÑA_SASL_DEL_BUZON_KOINONIA>
KOINONIA_SMTP_FROM=koinonia@stevenvallejo.com

# Rol de aplicación (migración 0003): la API sirve las peticiones como koinonia_app, que
# sobre governance.event sólo tiene SELECT e INSERT. KOINONIA_DB_APP_PASSWORD fija esta misma
# contraseña en el rol durante el arranque, con la conexión de migración.
KOINONIA_DATABASE_URL_APP=postgresql://koinonia_app:<CONTRASEÑA_ROL_APP>@koinonia-postgres:5432/koinonia
KOINONIA_DB_APP_PASSWORD=<CONTRASEÑA_ROL_APP>
