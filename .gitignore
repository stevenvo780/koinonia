node_modules/
dist/
coverage/
*.tsbuildinfo
.tsbuildinfo/
.vitest/
.eslintcache

# Entorno y secretos: nada de esto entra al repositorio.
.env
.env.*
!.env.example
# Plantilla de infra/produccion/: es un calco de las variables reales con los secretos sustituidos
# por marcadores (ver ese fichero y DESPLIEGUE.md). Sin esta excepción, el patrón `.env.*` de
# arriba se la comía también a ella.
!infra/produccion/.env.ejemplo
*.pem
*.key

# Ruido de editores y sistemas operativos.
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Rastros de los servidores MCP: describen la herramienta de quien edita, no el proyecto, y se
# regeneran solos en cada máquina. `.serena/` es su índice y su caché; `.playwright-mcp/` son los
# volcados de consola y de página que deja una sesión de navegador asistida.
.serena/
.playwright-mcp/

# Artefactos locales de verificación (los publicados viven fuera del repo de código).
/export/
/checkpoints-local/

# Artefactos de la interfaz y de las pruebas de extremo a extremo.
.next/
next-env.d.ts
/playwright-report/
/test-results/
/tests/e2e/.entorno.json

# Informe de mutación (Stryker). Se sube como artefacto de CI, no se versiona: son megabytes de
# HTML generado que cambian entero en cada corrida.
/reports/

# Arnés de mutantes equivalentes (tarea 23): trabajo local, no forma parte del árbol.
.harness/

# Ajustes personales de Claude Code: rutas y permisos de esta máquina, no del proyecto.
.claude/settings.local.json
